{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {"generateName": "attested-", "namespace": "secure-ai-layer3"},
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 1200,
    "template": {
      "metadata": {"labels": {"app": "cmdp-consumer-attested"}},
      "spec": {
        "runtimeClassName": "kata-qemu-coco-dev",
        "automountServiceAccountToken": false,
        "restartPolicy": "Never",
        "securityContext": {"runAsNonRoot": true, "runAsUser": 10001, "runAsGroup": 10001, "fsGroup": 10001},
        "containers": [{
          "name": "consumer",
          "image": "SET_BY_RENDERER_TO_DIGEST",
          "imagePullPolicy": "IfNotPresent",
          "envFrom": [{"configMapRef": {"name": "attested-public-config"}}],
          "securityContext": {"allowPrivilegeEscalation": false, "readOnlyRootFilesystem": true, "capabilities": {"drop": ["ALL"]}},
          "resources": {"requests": {"cpu": "500m", "memory": "1Gi"}, "limits": {"cpu": "2", "memory": "3Gi"}},
          "volumeMounts": [
            {"name": "work", "mountPath": "/work"},
            {"name": "signing-public", "mountPath": "/etc/model-signing", "readOnly": true}
          ]
        }],
        "volumes": [
          {"name": "work", "emptyDir": {"medium": "Memory", "sizeLimit": "768Mi"}},
          {"name": "signing-public", "configMap": {"name": "attested-signing-public", "defaultMode": 292}}
        ]
      }
    }
  }
}
